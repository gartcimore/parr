# parr-webhook sudoers drop-in
# Grants the parr-webhook service user permission to run exactly the commands
# needed by the action scripts. Nothing else.
#
# This file is installed at /etc/sudoers.d/parr-webhook by install.sh and
# validated with `visudo -cf` before being put in place.
#
# Each grant is a fully-specified command with no wildcards. restart-docker
# restarts the Docker daemon (host-level), which Homarr cannot do on its own.

parr-webhook ALL=(root) NOPASSWD: /sbin/reboot
parr-webhook ALL=(root) NOPASSWD: /sbin/poweroff
parr-webhook ALL=(root) NOPASSWD: /usr/bin/systemctl restart docker

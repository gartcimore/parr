[Unit]
Description=parr webhook daemon (adnanh/webhook)
After=network.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=parr-webhook
Group=parr-webhook
# -urlprefix webhook makes hooks served at /webhook/<id> instead of /hooks/<id>
# so Traefik can pass the path through unchanged.
#
# -ip binds the listener. It MUST be reachable from the Traefik container via
# the docker bridge gateway (host.docker.internal), so we cannot bind to
# 127.0.0.1. __WEBHOOK_IP__ is templated by install.sh (default 0.0.0.0).
# IMPORTANT: 0.0.0.0 exposes the daemon on every host interface including the
# LAN. The token is the only auth, so firewall __WEBHOOK_PORT__ to the docker
# bridge only. See webhook/README.md "Security notes".
ExecStart=/usr/bin/webhook \
    -hooks /etc/parr-webhook/hooks.json \
    -ip __WEBHOOK_IP__ \
    -port __WEBHOOK_PORT__ \
    -urlprefix webhook \
    -verbose
Restart=on-failure
RestartSec=5s

# Hardening. NoNewPrivileges is intentionally NOT set: the action scripts need
# sudo, which requires gaining privileges. Everything else is locked down.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

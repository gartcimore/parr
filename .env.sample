# Parr Configuration file
# Copy this file to .env and update the values below or run setup script

# Base configuration
TZ=Europe/Paris
DATA_DIR=/data
DOCKER_CONFIG_DIR=/docker/appdata
INSTALL_TYPE=service

# for Traefik configuration, service/container will be available at hostname/<service>
HOSTNAME=media.local

# Base domain for hostname-based HTTPS routes (e.g. radarr.${DOMAIN} -> radarr.example.org)
# Served with the wildcard *.example.org cert produced by an external acme container
DOMAIN=example.org

# Path to the TLS certs produced by an external acme/Let's Encrypt container.
# Mounted read-only into Traefik for hostname routes like jellyfin.${DOMAIN}
CERTS_DIR=/docker/appdata/certs

# Homarr configuration (will be auto-generated by setup.sh)
HOMARR_SECRET_KEY=your_homarr_secret_key_here

# VPN configuration for Gluetun
VPN_TYPE=wireguard
SERVER_COUNTRIES=Netherlands,Switzerland,Sweden

# OpenVPN credentials (for ProtonVPN)
OPENVPN_USER=your_username+pmp
OPENVPN_PASSWORD=your_password

# WireGuard configuration (for ProtonVPN)
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here

# Gluetun control server API key (generate with: docker run --rm qmcgaw/gluetun genkey)
GLUETUN_API_KEY=your_gluetun_api_key_here

# Preferred for qBittorrent 5.2.0+
QBT_API_KEY=API_KEY_HERE
QBT_AUTH_MODE=auto

# qBittorrent Web UI credentials (used by the watchdog)
QBT_USER=admin
QBT_PASS=your_qbittorrent_password

# parr-webhook configuration (host-side reboot/shutdown button for Homarr)
# WEBHOOK_TOKEN is auto-generated by setup.sh. Used as the X-Auth-Token header
# value when calling http://${HOSTNAME}/webhook/<action>. Keep secret.
WEBHOOK_TOKEN=your_webhook_token_here
WEBHOOK_PORT=9000
# Bind address for the host-side webhook daemon. Must stay reachable from the
# Traefik container via the docker bridge, so 0.0.0.0 is the default. This also
# exposes it on the LAN — firewall WEBHOOK_PORT to the docker bridge only.
WEBHOOK_IP=0.0.0.0

# Traefik dashboard basic auth (LAN-only, served at https://heimdall.${DOMAIN}).
# Value is a single user:hash pair. Generate it without installing anything,
# using the httpd Docker image (gives a proper bcrypt hash):
#   docker run --rm httpd:2.4 htpasswd -nbB admin 'yourpassword'
# Or with openssl (apr1 hash, also accepted by Traefik):
#   printf 'admin:'; openssl passwd -apr1 'yourpassword'
# Paste the resulting user:hash here, DOUBLING every '$' in the hash to '$$' so
# Docker Compose does not treat it as variable interpolation. Example (fake):
#   TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$abcdefghijklmnopqrstuv....
TRAEFIK_DASHBOARD_AUTH=admin:CHANGE_ME
